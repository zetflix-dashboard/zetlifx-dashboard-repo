{
  "name": "zetflix-dashboard",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --base /zetlifx-dashboard-repo/",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "check": "npm run format:check && npm run validate:charts && npm run validate:workspace && npm test && npm run build:pages",
    "validate:workspace": "node scripts/validate-workspace.mjs",
    "validate:charts": "node scripts/validate-charts.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{js,json,css}\" \"scripts/*.mjs\" \"tests/**/*.js\" index.html \"*.js\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{js,json,css}\" \"scripts/*.mjs\" \"tests/**/*.js\" index.html \"*.js\" \".github/workflows/*.yml\""
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "echarts": "6.1.0",
    "gridstack": "13.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "prettier": "3.5.3",
    "vite": "7.3.8"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "imports": {
    "#chart-datasets": "./scripts/chart-datasets.mjs"
  }
}
