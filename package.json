{
  "name": "zetflix-dashboard",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --base /zetlifx-dashboard-repo/",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "check": "npm run validate:charts && npm test && npm run build:pages",
    "validate:charts": "node scripts/validate-charts.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "echarts": "6.0.0",
    "gridstack": "13.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "vite": "7.3.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
